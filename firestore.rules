rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{userId}
    // Fields: uid, email, displayName, photoURL, provider, role, createdAt,
    // updatedAt, lastLoginAt. Profile fields are owner-readable; role is
    // created as guest and can only be promoted outside the client app.
    //
    // Collections: courses/{id}, schedules/{id}, teachers/{id}, news/{id}
    // Each content document includes createdAt and updatedAt timestamps.
    // Courses: name, duration, level, fee.
    // Schedules: title, type, date, startTime, endTime, venue, ticketURL,
    // bannerURL, ticketDesignURL, capacity, registrationCount, eventId
    // (workshops only), with an optional registrationOpen boolean.
    // Workshop registrations are stored
    // at schedules/{eventId}/registrations/{registrationId} and increment
    // registrationCount. Registration ids come from counters/registrations.
    // Duplicate emails are tracked by registrationEmails/{hash}.
    // Registration fields: name, email, vocalRange, registrationId,
    // registrationNumber, lookupId, ticketId, eventId, eventTitle, createdAt.
    // Teachers: name, specialty, bio, photoURL, email, profileURL.
    // News: category, title, excerpt, date, readTime, featured.
    // Site content is intentionally public-readable; only admins can write.
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isScanner() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'scanner'];
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function isBoundedString(data, field, minLength, maxLength) {
      return data[field] is string
        && data[field].size() >= minLength
        && data[field].size() <= maxLength;
    }

    function isOptionalString(data, field, maxLength) {
      return data[field] is string && data[field].size() <= maxLength;
    }

    function isValidUrl(value) {
      return value is string
        && value.size() <= 500
        && (value == '' || value.matches('^https://.*'));
    }

    function isValidEmail(value) {
      return value == null || value == ''
        || (value is string
          && value.size() <= 254
          && value.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$'));
    }

    function validContentTimestamps(data) {
      return data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidUser(data) {
      return hasRequiredFields(data, [
          'uid', 'email', 'displayName', 'photoURL', 'provider', 'role',
          'createdAt', 'updatedAt', 'lastLoginAt'
        ])
        && hasOnlyAllowedFields(data, [
          'uid', 'email', 'displayName', 'photoURL', 'provider', 'role',
          'createdAt', 'updatedAt', 'lastLoginAt', 'activeDeviceId'
        ])
        && data.uid is string
        && isValidEmail(data.email)
        && (data.displayName == null || isBoundedString(data, 'displayName', 0, 100))
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500))
        && (data.provider == null || isBoundedString(data, 'provider', 1, 50))
        && data.role in ['guest', 'admin', 'scanner']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastLoginAt is timestamp
        && (!('activeDeviceId' in data)
          || data.activeDeviceId == null
          || (data.activeDeviceId is string && data.activeDeviceId.size() <= 100));
    }

    function isValidCourse(data) {
      return hasRequiredFields(data, [
          'name', 'duration', 'level', 'fee', 'createdAt', 'updatedAt'
        ])
        && hasOnlyAllowedFields(data, [
          'name', 'duration', 'level', 'fee', 'createdAt', 'updatedAt'
        ])
        && isBoundedString(data, 'name', 1, 100)
        && isBoundedString(data, 'duration', 1, 50)
        && data.level in ['Beginner', 'Intermediate', 'Advanced']
        && data.fee is number
        && data.fee >= 0
        && data.fee <= 100000
        && validContentTimestamps(data);
    }

    function isValidSchedule(data) {
      return hasRequiredFields(data, [
          'title', 'type', 'date', 'startTime', 'endTime', 'venue',
          'ticketURL', 'bannerURL', 'ticketDesignURL', 'capacity', 'registrationCount',
          'createdAt', 'updatedAt'
        ])
        && hasOnlyAllowedFields(data, [
          'title', 'type', 'date', 'startTime', 'endTime', 'venue',
          'ticketURL', 'bannerURL', 'ticketDesignURL', 'capacity', 'registrationCount', 'eventId', 'registrationOpen',
          'createdAt', 'updatedAt'
        ])
        && isBoundedString(data, 'title', 1, 120)
        && data.type in ['Recital', 'Masterclass', 'Concert', 'Workshop', 'Exam']
        && data.date is timestamp
        && data.startTime is string
        && data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.endTime is string
        && data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.endTime > data.startTime
        && isBoundedString(data, 'venue', 1, 100)
        && isValidUrl(data.ticketURL)
        && isValidUrl(data.bannerURL)
        && (!('ticketDesignURL' in data) || isValidUrl(data.ticketDesignURL))
        && (!('eventId' in data) || isOptionalString(data, 'eventId', 100))
        && (!('registrationOpen' in data) || data.registrationOpen is bool)
        && data.capacity is int
        && data.capacity >= 0
        && data.capacity <= 100000
        && data.registrationCount is int
        && data.registrationCount >= 0
        && data.registrationCount <= data.capacity
        && (data.type != 'Concert' || data.ticketURL.size() > 0)
        && (data.type != 'Workshop' || data.capacity >= 1)
        && validContentTimestamps(data);
    }

    function isRegistrationIncrement() {
      return resource.data.type == 'Workshop'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'registrationCount'
        ])
        && request.resource.data.registrationCount == resource.data.get('registrationCount', 0) + 1
        && request.resource.data.registrationCount <= resource.data.get('capacity', 0);
    }

    function isNextRegistrationNumber(number) {
      let counterPath = /databases/$(database)/documents/counters/registrations;
      let after = getAfter(counterPath).data;

      return after.count == number
        && (
          (!exists(counterPath) && after.count == 1)
          || (exists(counterPath) && get(counterPath).data.count + 1 == after.count)
        );
    }

    function isValidRegistrationLookup(lookupId, data) {
      let registration = getAfter(
        /databases/$(database)/documents/schedules/$(data.eventId)/registrations/$(data.registrationId)
      ).data;

      return registration.lookupId == lookupId
        && registration.eventId == data.eventId
        && registration.registrationId == data.registrationId
        && registration.createdAt == data.createdAt;
    }

    function isValidWorkshopRegistration(eventId, registrationId) {
      let before = get(/databases/$(database)/documents/schedules/$(eventId)).data;
      let after = getAfter(/databases/$(database)/documents/schedules/$(eventId)).data;
      let data = request.resource.data;

      return before.type == 'Workshop'
        && after.type == 'Workshop'
        && before.get('registrationOpen', true) == true
        && before.get('capacity', 0) >= 1
        && after.get('registrationCount', 0) == before.get('registrationCount', 0) + 1
        && after.get('registrationCount', 0) <= before.get('capacity', 0)
        && hasRequiredFields(data, [
          'name', 'email', 'vocalRange', 'registrationId', 'registrationNumber',
          'lookupId', 'ticketId', 'eventId', 'eventTitle', 'createdAt'
        ])
        && hasOnlyAllowedFields(data, [
          'name', 'email', 'vocalRange', 'registrationId', 'registrationNumber',
          'lookupId', 'ticketId', 'eventId', 'eventTitle', 'createdAt'
        ])
        && data.eventId == eventId
        && data.registrationId == registrationId
        && data.registrationId is string
        && data.registrationId.matches('^[0-9]{6}$')
        && data.registrationNumber is int
        && data.registrationNumber >= 1
        && data.registrationNumber <= 999999
        && int(data.registrationId) == data.registrationNumber
        && isNextRegistrationNumber(data.registrationNumber)
        && data.lookupId is string
        && data.lookupId.size() >= 1
        && data.lookupId.size() <= 200
        && getAfter(
          /databases/$(database)/documents/registrationEmails/$(data.lookupId)
        ).data.registrationId == registrationId
        && getAfter(
          /databases/$(database)/documents/registrationEmails/$(data.lookupId)
        ).data.eventId == eventId
        && data.email is string
        && data.email.size() <= 254
        && data.email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$')
        && isBoundedString(data, 'name', 1, 100)
        && isBoundedString(data, 'vocalRange', 1, 50)
        && data.ticketId is string
        && data.ticketId.size() >= 1
        && data.ticketId.size() <= 150
        && data.ticketId.matches('^[A-Z0-9_-]+$')
        && isOptionalString(data, 'eventTitle', 120)
        && data.createdAt == request.time;
    }

    // A scanner (or admin) flipping a registration's checkedIn flag to true
    // for the first time. Only the check-in fields may be touched and the
    // guest must not have been checked in already.
    function isCheckInUpdate() {
      return isScanner()
        && resource.data.get('checkedIn', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'checkedIn', 'checkedInAt', 'checkedInBy', 'checkedInByName'
        ])
        && request.resource.data.checkedIn == true
        && request.resource.data.checkedInAt == request.time
        && request.resource.data.checkedInBy == request.auth.uid
        && request.resource.data.checkedInByName is string
        && request.resource.data.checkedInByName.size() <= 200;
    }

    function isValidTeacher(data) {
      return hasRequiredFields(data, [
          'name', 'specialty', 'bio', 'photoURL', 'email', 'profileURL',
          'createdAt', 'updatedAt'
        ])
        && hasOnlyAllowedFields(data, [
          'name', 'specialty', 'bio', 'photoURL', 'email', 'profileURL',
          'createdAt', 'updatedAt'
        ])
        && isBoundedString(data, 'name', 1, 100)
        && isBoundedString(data, 'specialty', 1, 100)
        && isBoundedString(data, 'bio', 1, 500)
        && isValidUrl(data.photoURL)
        && isValidEmail(data.email)
        && isValidUrl(data.profileURL)
        && validContentTimestamps(data);
    }

    function isValidNews(data) {
      return hasRequiredFields(data, [
          'category', 'title', 'excerpt', 'date', 'readTime', 'featured',
          'createdAt', 'updatedAt'
        ])
        && hasOnlyAllowedFields(data, [
          'category', 'title', 'excerpt', 'date', 'readTime', 'featured',
          'createdAt', 'updatedAt'
        ])
        && data.category in ['Announcement', 'Event', 'Faculty', 'Student', 'Campus']
        && isBoundedString(data, 'title', 1, 140)
        && isBoundedString(data, 'excerpt', 1, 1000)
        && data.date is timestamp
        && isOptionalString(data, 'readTime', 30)
        && data.featured is bool
        && validContentTimestamps(data);
    }

    function isNewContent() {
      return request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isUpdatedContent() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && uidUnchanged()
        && request.resource.data.role == 'guest'
        && request.resource.data.email == request.auth.token.email
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastLoginAt == request.time;

      allow update: if isOwner(userId)
        && uidNotModified()
        && isValidUser(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.photoURL == resource.data.photoURL
        && request.resource.data.provider == resource.data.provider
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastLoginAt == request.time
        && (
          request.resource.data.activeDeviceId == resource.data.get('activeDeviceId', null)
          || (resource.data.get('activeDeviceId', null) == null
            && request.resource.data.activeDeviceId is string)
          || (request.resource.data.activeDeviceId == null
            && resource.data.get('activeDeviceId', null) is string)
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt', 'lastLoginAt', 'activeDeviceId'
        ]);

      allow delete: if false;
    }

    match /courses/{documentId} {
      allow read: if true;
      allow create: if isAdmin()
        && isValidCourse(request.resource.data)
        && isNewContent();
      allow update: if isAdmin()
        && isValidCourse(request.resource.data)
        && isUpdatedContent();
      allow delete: if isAdmin();
    }

    match /schedules/{documentId} {
      allow read: if true;
      allow create: if isAdmin()
        && isValidSchedule(request.resource.data)
        && isNewContent();
      allow update: if (isAdmin()
          && isValidSchedule(request.resource.data)
          && isUpdatedContent())
        || isRegistrationIncrement();
      allow delete: if isAdmin();

      match /registrations/{registrationId} {
        allow read: if isAdmin() || isScanner();
        allow create: if isValidWorkshopRegistration(documentId, registrationId);
        allow update: if isAdmin() || isCheckInUpdate();
        allow delete: if isAdmin();
      }
    }

    match /counters/{counterId} {
      allow read: if true;
      allow create: if counterId == 'registrations'
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count == 1;
      allow update: if counterId == 'registrations'
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Collection group queries (collectionGroup('registrations') in
    // src/firebase/checkin.js) are NOT authorized by the nested
    // /schedules/{documentId}/registrations/{registrationId} rule above.
    // Firestore requires an explicit rule for the collection group, written
    // with a leading recursive wildcard. Without this, even admins get
    // "Missing or insufficient permissions" on the ticket lookup.
    match /{path=**}/registrations/{registrationId} {
      allow read: if isAdmin() || isScanner();
    }

    // Fast QR check-in lookup: ticketId -> { eventId, registrationId }.
    // Written atomically with the workshop registration, or lazily
    // backfilled by a scanner on the first scan of a legacy ticket.
    match /ticketLookup/{ticketId} {
      allow read: if isAdmin() || isScanner();
      allow create: if hasRequiredFields(request.resource.data, [
          'eventId', 'registrationId', 'ticketId', 'createdAt'
        ])
        && hasOnlyAllowedFields(request.resource.data, [
          'eventId', 'registrationId', 'ticketId', 'createdAt'
        ])
        && request.resource.data.ticketId == ticketId
        && request.resource.data.eventId is string
        && request.resource.data.registrationId is string
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/schedules/$(request.resource.data.eventId)/registrations/$(request.resource.data.registrationId)
        ).data.ticketId == ticketId;
      allow update, delete: if isAdmin();
    }

    match /registrationEmails/{lookupId} {
      allow read: if true;
      allow create: if hasRequiredFields(request.resource.data, [
          'eventId', 'registrationId', 'createdAt'
        ])
        && hasOnlyAllowedFields(request.resource.data, [
          'eventId', 'registrationId', 'createdAt'
        ])
        && request.resource.data.eventId is string
        && request.resource.data.registrationId is string
        && request.resource.data.createdAt == request.time
        && isValidRegistrationLookup(lookupId, request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /teachers/{documentId} {
      allow read: if true;
      allow create: if isAdmin()
        && isValidTeacher(request.resource.data)
        && isNewContent();
      allow update: if isAdmin()
        && isValidTeacher(request.resource.data)
        && isUpdatedContent();
      allow delete: if isAdmin();
    }

    match /news/{documentId} {
      allow read: if true;
      allow create: if isAdmin()
        && isValidNews(request.resource.data)
        && isNewContent();
      allow update: if isAdmin()
        && isValidNews(request.resource.data)
        && isUpdatedContent();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
